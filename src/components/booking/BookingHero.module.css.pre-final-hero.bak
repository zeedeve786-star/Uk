.hero {
  width: 100%;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 18% 18%,
      rgba(91, 101, 242, .07),
      transparent 28%
    ),
    radial-gradient(
      circle at 86% 72%,
      rgba(209, 92, 255, .06),
      transparent 28%
    ),
    #f7f9fd;
}

.heroInner {
  width: min(1240px, calc(100% - 40px));
  margin: 0 auto;
  padding: 52px 0 46px;
}

/* =========================
   INTRO
   ========================= */

.heroIntro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 26px;
}

.introCopy {
  max-width: 720px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 13px;
  color: #667085;
  font-size: 10px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: .16em;
}

.eyebrow i {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: linear-gradient(135deg, #5965f2, #d15cff);
  box-shadow:
    0 0 0 5px rgba(89, 101, 242, .08);
}

.introCopy h1 {
  margin: 0;
  color: #172033;
  font-size: clamp(40px, 5vw, 62px);
  line-height: .98;
  font-weight: 850;
  letter-spacing: -.052em;
}

.introCopy h1 span {
  display: inline;
  margin-left: 13px;
  color: #5965f2;
}

.introCopy p {
  max-width: 680px;
  margin: 15px 0 0;
  color: #697386;
  font-size: 15px;
  line-height: 1.65;
}

.introMeta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 9px;
  padding-bottom: 5px;
  color: #7b8496;
  font-size: 10px;
  font-weight: 750;
  white-space: nowrap;
}

.introMeta b {
  width: 4px;
  height: 4px;
  flex: 0 0 4px;
  border-radius: 50%;
  background: #d15cff;
}

/* =========================
   BOOKING STAGE
   ========================= */

.bookingStage {
  width: 100%;
  overflow: hidden;
  border: 1px solid #e3e7ef;
  border-radius: 24px;
  background: #ffffff;
  box-shadow:
    0 24px 65px rgba(31, 42, 72, .10),
    0 3px 12px rgba(31, 42, 72, .04);
}

.bookingStageTop {
  min-height: 94px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 21px 30px 18px;
  border-bottom: 1px solid #edf0f5;
  background: #ffffff;
}

.bookingEyebrow {
  display: block;
  margin-bottom: 6px;
  color: #5965f2;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .15em;
}

.bookingStageTop h2 {
  margin: 0;
  color: #172033;
  font-size: 27px;
  line-height: 1.1;
  letter-spacing: -.035em;
  font-weight: 850;
}

.bookingStageTop p {
  margin: 5px 0 0;
  color: #7b8496;
  font-size: 12px;
}

.onlineBadge {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: 1px solid #e2e6ee;
  border-radius: 999px;
  background: #fafbfc;
}

.onlineBadge i {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #35b779;
  box-shadow:
    0 0 0 4px rgba(53, 183, 121, .10);
}

.onlineBadge span {
  color: #697386;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .12em;
}

.bookingSurface {
  width: 100%;
  background: #ffffff;
}

.bookingSurface > * {
  width: 100%;
  min-width: 0;
}

.bookingTrust {
  min-height: 54px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 28px;
  padding: 12px 24px;
  border-top: 1px solid #edf0f5;
  background: #fbfcfe;
}

.bookingTrust div {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.bookingTrust span {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #5965f2;
  background: #eef0ff;
  font-size: 10px;
  font-weight: 900;
}

.bookingTrust strong {
  color: #697386;
  font-size: 10px;
  font-weight: 750;
}

/* =========================
   TABLET
   ========================= */

@media (max-width: 900px) {
  .heroInner {
    width: min(760px, calc(100% - 32px));
    padding-top: 38px;
  }

  .heroIntro {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .introMeta {
    justify-content: flex-start;
    white-space: normal;
  }

  .introCopy h1 {
    font-size: 48px;
  }

  .bookingStageTop {
    padding-left: 24px;
    padding-right: 24px;
  }
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 620px) {
  .heroInner {
    width: calc(100% - 20px);
    padding: 28px 0 30px;
  }

  .heroIntro {
    margin-bottom: 18px;
    gap: 14px;
  }

  .introCopy h1 {
    font-size: 39px;
    line-height: 1;
  }

  .introCopy h1 span {
    display: block;
    margin: 4px 0 0;
  }

  .introCopy p {
    margin-top: 13px;
    font-size: 13px;
    line-height: 1.6;
  }

  .introMeta {
    gap: 7px;
    font-size: 9px;
  }

  .bookingStage {
    border-radius: 19px;
  }

  .bookingStageTop {
    min-height: 88px;
    align-items: flex-start;
    padding: 18px;
  }

  .bookingStageTop h2 {
    font-size: 23px;
  }

  .bookingStageTop p {
    max-width: 270px;
    font-size: 11px;
    line-height: 1.45;
  }

  .onlineBadge {
    padding: 7px 9px;
  }

  .bookingTrust {
    justify-content: flex-start;
    gap: 10px 18px;
    padding: 12px 16px;
  }

  .bookingTrust strong {
    font-size: 9px;
  }
}
