.hero {
  position: relative;
  width: 100%;
  min-height: 760px;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(248,250,255,.91), rgba(248,250,255,.78)),
    url('/airport-hero-bg.svg') center / cover no-repeat;
}

.backgroundGlow {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 18% 28%, rgba(89,101,242,.13), transparent 28%),
    radial-gradient(circle at 76% 72%, rgba(209,92,255,.10), transparent 27%);
}

.heroInner {
  position: relative;
  z-index: 1;
  width: min(1500px, calc(100% - 40px));
  margin: 0 auto;
  padding: 48px 0 42px;
  display: grid;
  grid-template-columns: minmax(420px, .78fr) minmax(700px, 1.22fr);
  gap: 46px;
  align-items: center;
}

.leftColumn {
  min-width: 0;
  padding: 10px 0;
}

.intro {
  max-width: 650px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .18em;
  color: #5965f2;
}

.eyebrow i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: linear-gradient(135deg,#5965f2,#d15cff);
  box-shadow: 0 0 0 6px rgba(89,101,242,.10);
}

.intro h1 {
  margin: 0;
  max-width: 680px;
  font-size: clamp(48px, 5vw, 76px);
  line-height: .96;
  letter-spacing: -.055em;
  font-weight: 900;
  color: #172033;
}

.intro h1 span {
  display: block;
  color: #5965f2;
}

.intro p {
  max-width: 590px;
  margin: 22px 0 0;
  font-size: 16px;
  line-height: 1.75;
  color: #667085;
}

.visualPanel {
  position: relative;
  max-width: 600px;
  margin-top: 38px;
  padding: 25px 28px 23px;
  border: 1px solid rgba(255,255,255,.78);
  border-radius: 26px;
  background: rgba(255,255,255,.50);
  backdrop-filter: blur(10px);
  box-shadow: 0 24px 70px rgba(36,49,87,.09);
}

.visualTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8992a5;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .15em;
}

.visualTop b {
  color: #5965f2;
}

.routeVisual {
  position: relative;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12px 38px 0;
}

.routeLine {
  position: absolute;
  left: 17px;
  right: 17px;
  height: 2px;
  border-top: 2px dashed #aeb7ce;
}

.routePoint {
  position: relative;
  z-index: 2;
  width: 16px;
  height: 16px;
  border: 4px solid #5965f2;
  border-radius: 50%;
  background: #fff;
}

.routePlane,
.routeCar {
  position: absolute;
  z-index: 3;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid #e6e9f5;
  box-shadow: 0 12px 28px rgba(39,52,91,.10);
  color: #5965f2;
}

.routePlane {
  left: 46%;
  top: 12px;
  font-size: 20px;
}

.routeCar {
  right: 20%;
  bottom: 5px;
  color: #d15cff;
}

.visualLabels {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  margin-top: 4px;
}

.visualLabels div {
  display: grid;
  gap: 4px;
}

.visualLabels div:last-child {
  text-align: right;
}

.visualLabels strong {
  font-size: 13px;
  color: #283247;
}

.visualLabels span {
  font-size: 10px;
  color: #8a93a8;
}

.promiseRow {
  display: flex;
  flex-wrap: wrap;
  gap: 26px;
  margin-top: 27px;
}

.promiseRow div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.promiseRow span {
  color: #5965f2;
  font-size: 10px;
  font-weight: 850;
}

.promiseRow strong {
  font-size: 11px;
  color: #626c80;
}

.rightColumn {
  min-width: 0;
  width: 100%;
}

.bookingHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  padding: 0 5px 18px;
}

.bookingHeader span {
  display: block;
  margin-bottom: 7px;
  color: #5965f2;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .17em;
}

.bookingHeader h2 {
  margin: 0;
  color: #172033;
  font-size: clamp(31px, 3vw, 43px);
  line-height: 1;
  letter-spacing: -.045em;
  font-weight: 900;
}

.bookingHeader p {
  margin: 9px 0 0;
  color: #737d91;
  font-size: 13px;
}

.status {
  display: inline-flex !important;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 8px 12px;
  border: 1px solid rgba(89,101,242,.14);
  border-radius: 999px;
  background: rgba(255,255,255,.72);
  color: #697388 !important;
  font-size: 9px !important;
  letter-spacing: .12em;
}

.status i {
  width: 7px;
  height: 7px;
  margin: 0;
  border-radius: 50%;
  background: #35b779;
  box-shadow: 0 0 0 4px rgba(53,183,121,.10);
}

.widgetShell {
  width: 100%;
  min-width: 0;
}

.bookingFooter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 26px;
  padding: 15px 5px 0;
  color: #7d879a;
  font-size: 10px;
  font-weight: 750;
}

@media (max-width: 1100px) {
  .heroInner {
    grid-template-columns: 1fr;
    gap: 35px;
    width: min(900px, calc(100% - 32px));
  }

  .leftColumn {
    padding-bottom: 0;
  }

  .intro,
  .visualPanel {
    max-width: none;
  }
}

@media (max-width: 700px) {
  .hero {
    min-height: auto;
  }

  .heroInner {
    width: calc(100% - 22px);
    padding: 28px 0;
    gap: 25px;
  }

  .intro h1 {
    font-size: 44px;
  }

  .intro p {
    font-size: 14px;
  }

  .visualPanel {
    margin-top: 25px;
    padding: 21px;
    border-radius: 21px;
  }

  .promiseRow {
    gap: 12px 20px;
  }

  .bookingHeader {
    align-items: flex-start;
    flex-direction: column;
  }

  .bookingFooter {
    gap: 12px;
  }
}
