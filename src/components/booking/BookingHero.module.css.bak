.hero {
  width: 100%;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 18%, rgba(118, 92, 255, 0.10), transparent 30%),
    radial-gradient(circle at 12% 82%, rgba(59, 130, 246, 0.08), transparent 28%),
    #f8faff;
}

.heroInner {
  width: min(1500px, calc(100% - 40px));
  margin: 0 auto;
  padding: 38px 0 34px;

  display: grid;
  grid-template-columns: minmax(390px, 0.72fr) minmax(760px, 1.28fr);
  gap: 34px;
  align-items: stretch;
}

.leftColumn {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.intro {
  padding: 4px 4px 6px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 14px;

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #667085;
}

.eyebrow i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: linear-gradient(135deg, #5965f2, #d15cff);
  box-shadow: 0 0 0 5px rgba(89, 101, 242, 0.09);
}

.intro h1 {
  margin: 0;
  max-width: 520px;

  font-size: clamp(42px, 4vw, 64px);
  line-height: 0.98;
  letter-spacing: -0.045em;
  font-weight: 850;
  color: #172033;
}

.intro h1 span {
  display: block;
  color: #5965f2;
}

.intro p {
  max-width: 520px;
  margin: 18px 0 0;

  font-size: 16px;
  line-height: 1.7;
  color: #667085;
}

.featureCard,
.serviceCard {
  border: 1px solid rgba(112, 122, 160, 0.14);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18px 50px rgba(31, 42, 72, 0.07);
}

.featureCard {
  padding: 25px 26px 24px;
}

.cardTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.cardLabel {
  font-size: 10px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: 0.15em;
  color: #8a93a8;
}

.cardNumber {
  font-size: 12px;
  font-weight: 850;
  color: #5965f2;
}

.featureCard h2,
.serviceCard h2 {
  margin: 19px 0 8px;

  font-size: 25px;
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: #172033;
}

.featureCard h2 span {
  display: block;
  color: #5965f2;
}

.featureCard > p {
  margin: 0 0 20px;
  font-size: 14px;
  line-height: 1.65;
  color: #6d7689;
}

.benefitList {
  display: grid;
  gap: 13px;
}

.benefit {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.benefit > span {
  flex: 0 0 25px;
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 8px;
  background: #eef0ff;
  color: #5965f2;

  font-size: 13px;
  font-weight: 900;
}

.benefit strong {
  display: block;
  margin-bottom: 2px;
  font-size: 13px;
  color: #283247;
}

.benefit small {
  display: block;
  font-size: 11px;
  line-height: 1.45;
  color: #8a93a8;
}

.serviceCard {
  padding: 24px 26px 20px;
}

.serviceHeading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.serviceCard h2 {
  margin-bottom: 0;
}

.serviceHeading strong {
  display: block;
  margin-top: 2px;
  font-size: 25px;
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: #5965f2;
}

.routeGraphic {
  min-width: 130px;
  display: flex;
  align-items: center;
  gap: 5px;
}

.routeGraphic span {
  width: 7px;
  height: 7px;
  border: 2px solid #5965f2;
  border-radius: 50%;
}

.routeGraphic b {
  flex: 1;
  height: 1px;
  border-top: 1px dashed #b9c0d4;
}

.routeGraphic i {
  font-size: 14px;
  color: #d15cff;
  font-style: normal;
}

.serviceGrid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.serviceGrid div {
  min-height: 72px;
  padding: 12px 9px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;

  border-radius: 13px;
  background: #f6f7fc;
}

.serviceGrid span {
  font-size: 17px;
  color: #5965f2;
}

.serviceGrid strong {
  font-size: 10px;
  color: #525d73;
}

.serviceFooter {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 17px;

  font-size: 10px;
  font-weight: 700;
  color: #9299aa;
}

.rightColumn {
  min-width: 0;
  width: 100%;

  display: flex;
  flex-direction: column;
}

.quoteHeading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;

  padding: 4px 5px 17px;
}

.quoteHeading > div:first-child {
  min-width: 0;
}

.quoteHeading span {
  display: block;
  margin-bottom: 7px;

  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.16em;
  color: #5965f2;
}

.quoteHeading h2 {
  margin: 0;

  font-size: clamp(31px, 3vw, 43px);
  line-height: 1;
  letter-spacing: -0.04em;
  font-weight: 850;
  color: #172033;
}

.quoteHeading p {
  margin: 9px 0 0;
  font-size: 14px;
  color: #737d91;
}

.liveBadge {
  flex: 0 0 auto !important;
  display: inline-flex !important;
  align-items: center;
  gap: 8px;

  margin: 0 !important;
  padding: 8px 12px;

  border: 1px solid rgba(89, 101, 242, 0.13);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);

  font-size: 10px !important;
  font-weight: 850 !important;
  letter-spacing: 0.12em;
  color: #667085 !important;
}

.liveBadge i {
  width: 7px;
  height: 7px;
  margin: 0;
  border-radius: 50%;
  background: #35b779;
  box-shadow: 0 0 0 4px rgba(53, 183, 121, 0.10);
}

.widgetShell {
  width: 100%;
  min-width: 0;
  flex: 1;

  border-radius: 28px;
  background: #ffffff;
  box-shadow:
    0 26px 70px rgba(29, 42, 78, 0.12),
    0 2px 8px rgba(29, 42, 78, 0.04);

  overflow: hidden;
}

.widgetShell > * {
  width: 100%;
  min-width: 0;
}

.quoteFooter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 25px;

  padding: 15px 5px 0;

  font-size: 11px;
  font-weight: 700;
  color: #7d879a;
}

@media (max-width: 1250px) {
  .heroInner {
    width: min(1180px, calc(100% - 32px));
    grid-template-columns: minmax(330px, 0.62fr) minmax(650px, 1.38fr);
    gap: 24px;
  }

  .intro h1 {
    font-size: 50px;
  }
}

@media (max-width: 1050px) {
  .heroInner {
    width: min(900px, calc(100% - 32px));
    grid-template-columns: 1fr;
  }

  .leftColumn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .intro {
    grid-column: 1 / -1;
  }

  .rightColumn {
    width: 100%;
  }
}

@media (max-width: 700px) {
  .heroInner {
    width: calc(100% - 22px);
    padding: 22px 0;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .leftColumn {
    display: flex;
  }

  .intro h1 {
    font-size: 42px;
  }

  .featureCard,
  .serviceCard {
    border-radius: 20px;
    padding: 21px;
  }

  .serviceGrid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quoteHeading {
    align-items: flex-start;
    flex-direction: column;
  }

  .widgetShell {
    border-radius: 22px;
  }

  .quoteFooter {
    gap: 12px;
  }
}
