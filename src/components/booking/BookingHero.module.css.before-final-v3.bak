.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f4f7fc;
}

.heroBackground {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      rgba(245,248,253,.96) 0%,
      rgba(245,248,253,.88) 44%,
      rgba(245,248,253,.72) 100%
    );
}

.airportGlow {
  position: absolute;
  width: 900px;
  height: 900px;
  right: -180px;
  top: -290px;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(104,119,245,.18) 0%,
      rgba(104,119,245,.07) 38%,
      transparent 70%
    );
}

.airportStructure {
  position: absolute;
  right: -80px;
  bottom: -80px;
  width: 900px;
  height: 500px;
  transform: perspective(700px) rotateX(7deg) rotateY(-7deg);
  opacity: .22;
}

.airportStructure span {
  position: absolute;
  display: block;
  bottom: 0;
  width: 110px;
  height: 430px;
  border-left: 2px solid #7d8bad;
  border-right: 2px solid #7d8bad;
  background: linear-gradient(
    180deg,
    rgba(255,255,255,.02),
    rgba(115,132,170,.10)
  );
}

.airportStructure span:nth-child(1) { left: 0; }
.airportStructure span:nth-child(2) { left: 180px; }
.airportStructure span:nth-child(3) { left: 360px; }
.airportStructure span:nth-child(4) { left: 540px; }
.airportStructure span:nth-child(5) { left: 720px; }

.flightPath {
  position: absolute;
  right: 18%;
  top: 17%;
  width: 430px;
  height: 130px;
  transform: rotate(-9deg);
  opacity: .20;
}

.flightPath b {
  position: absolute;
  left: 20px;
  right: 20px;
  top: 55px;
  border-top: 2px dashed #5965f2;
}

.flightPath i {
  position: absolute;
  width: 13px;
  height: 13px;
  border: 3px solid #5965f2;
  border-radius: 50%;
  background: #f4f7fc;
}

.flightPath i:first-child {
  left: 0;
  top: 48px;
}

.flightPath i:last-child {
  right: 0;
  top: 48px;
}

.heroInner {
  position: relative;
  z-index: 1;
  width: min(1500px, calc(100% - 40px));
  margin: 0 auto;
  padding: 48px 0 42px;
  display: grid;
  grid-template-columns: minmax(420px, .78fr) minmax(700px, 1.22fr);
  gap: 48px;
  align-items: center;
}

.leftColumn {
  min-width: 0;
  padding: 10px 0;
}

.intro {
  max-width: 650px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 17px;
  color: #5965f2;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .18em;
}

.eyebrow i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: linear-gradient(135deg,#5965f2,#d15cff);
  box-shadow: 0 0 0 5px rgba(89,101,242,.10);
}

.intro h1 {
  margin: 0;
  max-width: 650px;
  color: #172033;
  font-size: clamp(48px, 5vw, 74px);
  line-height: .96;
  letter-spacing: -.055em;
  font-weight: 900;
}

.intro h1 span {
  display: block;
  color: #5965f2;
}

.intro p {
  max-width: 580px;
  margin: 21px 0 0;
  color: #687287;
  font-size: 16px;
  line-height: 1.72;
}

.routeArtwork {
  position: relative;
  height: 205px;
  max-width: 630px;
  margin-top: 35px;
  overflow: hidden;
  border-radius: 30px;
  border: 1px solid rgba(255,255,255,.72);
  background:
    linear-gradient(
      180deg,
      rgba(229,236,251,.48),
      rgba(255,255,255,.58)
    );
  box-shadow: 0 22px 55px rgba(37,49,82,.08);
}

.routeSky {
  position: absolute;
  inset: 0 0 52% 0;
}

.cloudOne,
.cloudTwo {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.75);
  filter: blur(1px);
}

.cloudOne {
  width: 110px;
  height: 30px;
  left: 12%;
  top: 30px;
}

.cloudTwo {
  width: 150px;
  height: 35px;
  right: 15%;
  top: 55px;
}

.routeRoad {
  position: absolute;
  left: -8%;
  right: -8%;
  bottom: -82px;
  height: 170px;
  transform: perspective(350px) rotateX(58deg);
  background: #cbd3e2;
  border-top: 1px solid rgba(89,101,242,.15);
}

.routeRoadLine {
  position: absolute;
  left: 45%;
  top: 20px;
  width: 10%;
  height: 120px;
  border-left: 3px dashed rgba(255,255,255,.85);
}

.airplane {
  position: absolute;
  left: 43%;
  top: 42px;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: rgba(255,255,255,.92);
  color: #5965f2;
  box-shadow: 0 10px 24px rgba(46,61,101,.10);
  font-size: 20px;
}

.carIllustration {
  position: absolute;
  right: 13%;
  bottom: 30px;
  width: 105px;
  height: 48px;
}

.carBody {
  position: absolute;
  left: 4px;
  bottom: 7px;
  width: 97px;
  height: 28px;
  border-radius: 14px 18px 9px 9px;
  background: linear-gradient(135deg,#5965f2,#737ff5);
  box-shadow: 0 10px 20px rgba(65,78,160,.18);
}

.carRoof {
  position: absolute;
  left: 28px;
  bottom: 29px;
  width: 50px;
  height: 22px;
  border-radius: 24px 24px 4px 4px;
  background: #4f5fd4;
}

.carIllustration i {
  position: absolute;
  bottom: 0;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #202b42;
  border: 3px solid #fff;
}

.carIllustration i:nth-of-type(1) { left: 18px; }
.carIllustration i:nth-of-type(2) { right: 13px; }

.routeLabel {
  position: absolute;
  left: 27px;
  bottom: 25px;
  display: grid;
  gap: 4px;
}

.routeLabel strong {
  color: #34405a;
  font-size: 10px;
  letter-spacing: .14em;
}

.routeLabel span {
  color: #7e8799;
  font-size: 10px;
}

.leftPoints {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 22px;
}

.leftPoints span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #687287;
  font-size: 11px;
  font-weight: 700;
}

.leftPoints b {
  display: grid;
  place-items: center;
  width: 19px;
  height: 19px;
  border-radius: 6px;
  background: #eef0ff;
  color: #5965f2;
  font-size: 10px;
}

.rightColumn {
  min-width: 0;
  width: 100%;
}

.bookingPanel {
  width: 100%;
  overflow: hidden;
  border: 1px solid rgba(221,226,237,.92);
  border-radius: 26px;
  background: rgba(255,255,255,.96);
  box-shadow:
    0 30px 80px rgba(33,46,80,.13),
    0 5px 18px rgba(33,46,80,.05);
}

.bookingHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 25px 29px 22px;
  border-bottom: 1px solid #edf0f5;
}

.bookingHeader > div:first-child {
  min-width: 0;
}

.bookingHeader span {
  display: block;
  margin-bottom: 6px;
  color: #5965f2;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .16em;
}

.bookingHeader h2 {
  margin: 0;
  color: #172033;
  font-size: 30px;
  line-height: 1.05;
  letter-spacing: -.04em;
  font-weight: 900;
}

.bookingHeader p {
  margin: 7px 0 0;
  color: #7a8497;
  font-size: 12px;
}

.online {
  display: inline-flex !important;
  align-items: center;
  gap: 7px;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 8px 11px;
  border: 1px solid #e3e7f0;
  border-radius: 999px;
  background: #fafbfc;
  color: #687287 !important;
  font-size: 9px !important;
  letter-spacing: .1em;
}

.online i {
  width: 7px;
  height: 7px;
  margin: 0;
  border-radius: 50%;
  background: #35b779;
}

.widgetArea {
  width: 100%;
}

.bookingFooter {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 25px;
  padding: 14px 20px;
  border-top: 1px solid #edf0f5;
  background: #fafbfc;
  color: #7d879a;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 1150px) {
  .heroInner {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .leftColumn {
    padding-bottom: 0;
  }

  .routeArtwork {
    max-width: none;
  }
}

@media (max-width: 700px) {
  .heroInner {
    width: calc(100% - 22px);
    padding: 28px 0;
  }

  .intro h1 {
    font-size: 44px;
  }

  .intro p {
    font-size: 14px;
  }

  .routeArtwork {
    height: 180px;
    border-radius: 22px;
  }

  .bookingHeader {
    align-items: flex-start;
    flex-direction: column;
    padding: 21px;
  }

  .bookingHeader h2 {
    font-size: 27px;
  }

  .bookingFooter {
    gap: 12px;
  }
}
