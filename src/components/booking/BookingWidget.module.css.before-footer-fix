.widget {
  width: 100%;
  max-width: none;
  margin: 0;
  overflow: hidden;
  border: 1px solid #e4e9f1;
  border-radius: 22px;
  background: #ffffff;
  box-shadow:
    0 24px 60px rgba(15, 23, 42, 0.13),
    0 5px 18px rgba(15, 23, 42, 0.06);
}

/* =========================
   BOOKING HEADER
   ========================= */

.header {
  position: relative;
  min-height: 132px;
  padding: 24px 30px 22px;
  overflow: hidden;
  color: #ffffff;
  background:
    linear-gradient(
      115deg,
      #10255b 0%,
      #173b82 55%,
      #315fc1 100%
    );
}

.header::before {
  content: "";
  position: absolute;
  width: 230px;
  height: 230px;
  right: -75px;
  top: -120px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 50%;
  pointer-events: none;
}

.header::after {
  content: "";
  position: absolute;
  width: 170px;
  height: 170px;
  right: 35px;
  bottom: -110px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 50%;
  pointer-events: none;
}

.headerTop {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.headerTitle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  text-align: center;
}

.titleMark {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(255,255,255,.13);
  border: 1px solid rgba(255,255,255,.18);
}

.titleMark::before {
  content: "↗";
  font-size: 23px;
  font-weight: 800;
}

.headerTitle h2 {
  margin: 0 0 4px;
  color: #ffffff;
  font-size: 24px;
  line-height: 1.1;
  letter-spacing: -.5px;
  text-align: center;
}

.headerTitle p {
  margin: 0;
  color: rgba(255,255,255,.72);
  font-size: 11px;
  line-height: 1.45;
  text-align: center;
}

.phone {
  display: none;
}

.heroRoute {
  position: absolute;
  z-index: 2;
  right: 20px;
  bottom: 7px;
  width: 215px;
  height: 67px;
  opacity: .85;
  pointer-events: none;
}

.routeLine {
  position: absolute;
  left: 12px;
  right: 20px;
  top: 37px;
  height: 2px;
  background:
    linear-gradient(
      90deg,
      #7dd3fc,
      #a78bfa,
      #f9a8d4
    );
  transform: rotate(-10deg);
  transform-origin: left center;
}

.routeLine::after {
  content: "";
  position: absolute;
  right: 0;
  top: -3px;
  width: 8px;
  height: 8px;
  border-top: 2px solid #f9a8d4;
  border-right: 2px solid #f9a8d4;
  transform: rotate(35deg);
}

.routePin {
  position: absolute;
  width: 12px;
  height: 12px;
  border: 3px solid #ffffff;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow:
    0 0 0 5px rgba(56,189,248,.18);
}

.routePinStart {
  left: 2px;
  top: 43px;
}

.routePinEnd {
  right: 7px;
  top: 12px;
  background: #ec4899;
  box-shadow:
    0 0 0 5px rgba(236,72,153,.18);
}

.routeCar {
  position: absolute;
  left: 91px;
  top: 30px;
  width: 58px;
  height: 24px;
  border-radius: 14px 17px 7px 7px;
  background:
    linear-gradient(
      135deg,
      #ffffff,
      #dbeafe
    );
  box-shadow:
    0 8px 16px rgba(0,0,0,.18);
}

.routeCar::before {
  content: "";
  position: absolute;
  left: 14px;
  top: -9px;
  width: 29px;
  height: 13px;
  border-radius: 10px 10px 2px 2px;
  background: #dbeafe;
  border: 2px solid rgba(255,255,255,.85);
}

.routeCar::after {
  content: "";
  position: absolute;
  left: 8px;
  bottom: -8px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #172033;
  box-shadow: 36px 0 0 #172033;
}

/* =========================
   FORM AREA
   ========================= */

.formArea {
  width: 100%;
  background: #ffffff;
  text-align: left;
}

.stepTransition {
  width: 100%;
  animation: bookingAppear .2s ease-out;
}

@keyframes bookingAppear {
  from {
    opacity: .65;
    transform: translateY(3px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stepStack {
  width: 100%;
  padding: 20px;
}

/* =========================
   WIDGET FOOTER / CONTACT
   ========================= */

.contactLine {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 48px;
  padding: 11px 24px;
  border-top: 1px solid #e8ecf2;
  background: #f8fafc;
  color: #7a8495;
  font-size: 11px;
  line-height: 1.4;
  text-align: center;
}

.contactLine > span {
  white-space: nowrap;
}

.contactLine > div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.contactLine a {
  color: #315db9;
  font-weight: 750;
  text-decoration: none;
}

.contactLine a:hover {
  text-decoration: underline;
}

.contactLine i {
  width: 3px;
  height: 3px;
  flex: 0 0 3px;
  border-radius: 50%;
  background: #b5bdc9;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 700px) {
  .header {
    padding: 22px 20px;
  }

  .headerTitle h2 {
    font-size: 22px;
  }

  .heroRoute {
    right: 8px;
    opacity: .45;
  }

  .contactLine {
    flex-direction: column;
    gap: 5px;
    padding: 12px 18px;
  }
}

@media (max-width: 480px) {
  .widget {
    border-radius: 18px;
  }

  .header {
    min-height: 118px;
    padding: 20px 16px;
  }

  .titleMark {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
  }

  .headerTitle {
    gap: 9px;
  }

  .headerTitle h2 {
    font-size: 20px;
  }

  .headerTitle p {
    font-size: 10px;
  }

  .heroRoute {
    display: none;
  }

  .contactLine > div {
    flex-wrap: wrap;
  }
}

