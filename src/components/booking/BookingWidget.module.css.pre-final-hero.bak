.widget {
  width: 100%;
  max-width: none;
  margin: 0;
  overflow: hidden;
  border: 0;
  border-radius: 22px;
  background: #ffffff;
  box-shadow:
    0 24px 60px rgba(15, 23, 42, 0.16),
    0 4px 18px rgba(15, 23, 42, 0.08);
}

/* =========================
   HEADER
   ========================= */

.header {
  position: relative;
  min-height: 112px;
  padding: 20px 24px;
  overflow: hidden;
  color: #ffffff;
  background:
    linear-gradient(
      115deg,
      #10255b 0%,
      #173b82 58%,
      #2859b7 100%
    );
}

.header::before {
  content: "";
  position: absolute;
  width: 210px;
  height: 210px;
  right: -70px;
  top: -105px;
  border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 50%;
  pointer-events: none;
}

.header::after {
  content: "";
  position: absolute;
  width: 150px;
  height: 150px;
  right: 40px;
  bottom: -95px;
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 50%;
  pointer-events: none;
}

.headerTop {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.headerTitle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex: 1;
  text-align: center;
}

.titleMark {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(255, 255, 255, .13);
  border: 1px solid rgba(255, 255, 255, .18);
}

.titleMark::before {
  content: "↗";
  font-size: 22px;
  font-weight: 800;
}

.headerTitle h2 {
  margin: 1px 0 4px;
  color: #ffffff;
  font-size: 23px;
  line-height: 1.1;
  letter-spacing: -.5px;
  text-align: center;
}

.headerTitle p {
  margin: 0;
  max-width: 310px;
  color: rgba(255, 255, 255, .72);
  font-size: 11px;
  line-height: 1.45;
  text-align: center;
}

.phone {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  padding: 8px 10px;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 10px;
  color: #ffffff;
  text-decoration: none;
  background: rgba(255, 255, 255, .08);
  backdrop-filter: blur(8px);
}

.phone span {
  color: rgba(255, 255, 255, .55);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.phone strong {
  font-size: 11px;
  white-space: nowrap;
}

.heroRoute {
  position: absolute;
  z-index: 2;
  right: 17px;
  bottom: 6px;
  width: 215px;
  height: 67px;
  opacity: .85;
  pointer-events: none;
}

.routeLine {
  position: absolute;
  left: 12px;
  right: 20px;
  top: 37px;
  height: 2px;
  background:
    linear-gradient(
      90deg,
      #7dd3fc,
      #a78bfa,
      #f9a8d4
    );
  transform: rotate(-10deg);
  transform-origin: left center;
}

.routeLine::after {
  content: "";
  position: absolute;
  right: 0;
  top: -3px;
  width: 8px;
  height: 8px;
  border-top: 2px solid #f9a8d4;
  border-right: 2px solid #f9a8d4;
  transform: rotate(35deg);
}

.routePin {
  position: absolute;
  width: 12px;
  height: 12px;
  border: 3px solid #ffffff;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow:
    0 0 0 5px rgba(56, 189, 248, .18);
}

.routePinStart {
  left: 2px;
  top: 43px;
}

.routePinEnd {
  right: 7px;
  top: 12px;
  background: #ec4899;
  box-shadow:
    0 0 0 5px rgba(236, 72, 153, .18);
}

.routeCar {
  position: absolute;
  left: 91px;
  top: 30px;
  width: 58px;
  height: 24px;
  border-radius: 14px 17px 7px 7px;
  background:
    linear-gradient(
      135deg,
      #ffffff,
      #dbeafe
    );
  box-shadow:
    0 8px 16px rgba(0, 0, 0, .18);
}

.routeCar::before {
  content: "";
  position: absolute;
  left: 14px;
  top: -9px;
  width: 29px;
  height: 13px;
  border-radius: 10px 10px 2px 2px;
  background: #dbeafe;
  border: 2px solid rgba(255, 255, 255, .85);
}

.routeCar::after {
  content: "";
  position: absolute;
  left: 8px;
  bottom: -8px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #172033;
  box-shadow: 36px 0 0 #172033;
}

/* =========================
   CONTACT STRIP
   ========================= */

.contactLine {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 52px;
  margin: 0;
  padding: 11px 24px;
  border-top: 1px solid rgba(255, 255, 255, .12);
  color: rgba(255, 255, 255, .74);
  background:
    linear-gradient(
      115deg,
      #10255b 0%,
      #173b82 58%,
      #2859b7 100%
    );
  font-size: 11px;
  line-height: 1.4;
  text-align: center;
}

.contactLine > span {
  color: rgba(255, 255, 255, .68);
}

.contactLine > div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.contactLine a {
  color: #ffffff;
  font-weight: 750;
  text-decoration: none;
}

.contactLine a:hover {
  color: #dbeafe;
  text-decoration: underline;
}

.contactLine i {
  width: 4px;
  height: 4px;
  flex: 0 0 4px;
  border-radius: 50%;
  background: #f9a8d4;
}

/* =========================
   FORM
   ========================= */

.formArea {
  width: 100%;
  background: #ffffff;
  text-align: left;
}

.stepTransition {
  width: 100%;
  animation: bookingAppear .2s ease-out;
}

@keyframes bookingAppear {
  from {
    opacity: .65;
    transform: translateY(3px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stepStack {
  padding: 20px;
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 620px) {
  .widget {
    border-radius: 18px;
  }

  .header {
    min-height: 104px;
    padding: 18px;
  }

  .phone {
    display: none;
  }

  .headerTitle {
    justify-content: center;
  }

  .headerTitle h2 {
    font-size: 21px;
  }

  .heroRoute {
    opacity: .5;
  }

  .contactLine {
    flex-direction: column;
    gap: 5px;
    min-height: 60px;
    padding: 10px 16px;
  }

  .contactLine > div {
    flex-wrap: wrap;
  }
}
