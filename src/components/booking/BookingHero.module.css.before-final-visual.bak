.hero {
  position: relative;
  width: 100%;
  min-height: 790px;
  overflow: hidden;
  background: #eef2f8;
}

.heroBackdrop {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      rgba(239,243,249,.93) 0%,
      rgba(239,243,249,.82) 42%,
      rgba(239,243,249,.72) 100%
    );
}

.backdropTerminal {
  position: absolute;
  right: -4%;
  top: -10%;
  width: 72%;
  height: 105%;
  opacity: .14;
  transform: skewX(-7deg);
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0 115px,
      #536584 116px 118px,
      transparent 119px 230px
    ),
    linear-gradient(
      170deg,
      transparent 0 35%,
      #687b9c 36% 37%,
      transparent 38%
    );
}

.backdropLight {
  position: absolute;
  right: 5%;
  top: 8%;
  width: 650px;
  height: 650px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(104,119,245,.16),
    rgba(104,119,245,.05) 42%,
    transparent 70%
  );
}

.backdropRoad {
  position: absolute;
  left: -5%;
  right: -5%;
  bottom: -170px;
  height: 310px;
  opacity: .16;
  transform: perspective(600px) rotateX(58deg);
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0 210px,
      rgba(89,101,242,.8) 211px 214px,
      transparent 215px 420px
    ),
    #68758e;
}

.heroInner {
  position: relative;
  z-index: 1;
  width: min(1500px, calc(100% - 40px));
  min-height: 790px;
  margin: 0 auto;
  padding: 45px 0;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(440px, .78fr) minmax(700px, 1.22fr);
  gap: 52px;
  align-items: center;
}

.leftColumn {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.intro {
  max-width: 650px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 16px;
  color: #5965f2;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .18em;
}

.eyebrow i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: linear-gradient(135deg,#5965f2,#d15cff);
  box-shadow: 0 0 0 5px rgba(89,101,242,.10);
}

.intro h1 {
  margin: 0;
  max-width: 680px;
  color: #172033;
  font-size: clamp(49px, 5vw, 76px);
  line-height: .95;
  letter-spacing: -.055em;
  font-weight: 900;
}

.intro h1 span {
  display: block;
  color: #5965f2;
}

.intro p {
  max-width: 585px;
  margin: 20px 0 0;
  color: #687287;
  font-size: 15px;
  line-height: 1.72;
}

.mainIllustration {
  position: relative;
  height: 265px;
  margin-top: 30px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.78);
  border-radius: 30px;
  background: linear-gradient(
    180deg,
    rgba(221,230,247,.65),
    rgba(255,255,255,.72)
  );
  box-shadow: 0 25px 60px rgba(37,49,82,.10);
}

.illustrationSky {
  position: absolute;
  inset: 0;
}

.cloudA,
.cloudB {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.78);
}

.cloudA {
  width: 145px;
  height: 34px;
  left: 9%;
  top: 35px;
}

.cloudB {
  width: 180px;
  height: 40px;
  right: 14%;
  top: 58px;
}

.sunGlow {
  position: absolute;
  right: 16%;
  top: 12px;
  width: 115px;
  height: 115px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255,255,255,.75),
    rgba(255,255,255,0)
  );
}

.terminal {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 66px;
  height: 100px;
}

.terminalRoof {
  position: absolute;
  left: -4%;
  right: -4%;
  top: 0;
  height: 12px;
  border-radius: 10px;
  background: #7b89a4;
  opacity: .65;
}

.terminalGlass {
  position: absolute;
  inset: 12px 0 0;
  display: flex;
  gap: 7px;
  padding: 8px;
  background: rgba(104,121,151,.16);
  border: 1px solid rgba(104,121,151,.25);
}

.terminalGlass span {
  flex: 1;
  border: 1px solid rgba(255,255,255,.65);
  background: linear-gradient(
    180deg,
    rgba(255,255,255,.45),
    rgba(104,121,151,.08)
  );
}

.terminalSign {
  position: absolute;
  top: 36px;
  left: 45%;
  padding: 5px 9px;
  border-radius: 5px;
  background: #5965f2;
  color: #fff;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .15em;
}

.runway {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -70px;
  height: 145px;
  transform: perspective(350px) rotateX(58deg);
  background: #aeb8c9;
  opacity: .7;
}

.runwayCenter {
  position: absolute;
  left: 48%;
  top: 0;
  width: 7%;
  height: 145px;
  border-left: 3px dashed rgba(255,255,255,.85);
}

.plane {
  position: absolute;
  left: 34%;
  top: 39px;
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: rgba(255,255,255,.94);
  color: #5965f2;
  box-shadow: 0 12px 25px rgba(45,57,94,.13);
  font-size: 21px;
}

.taxi {
  position: absolute;
  right: 11%;
  bottom: 27px;
  width: 125px;
  height: 62px;
}

.taxiRoof {
  position: absolute;
  left: 29px;
  bottom: 31px;
  width: 65px;
  height: 25px;
  border-radius: 30px 30px 5px 5px;
  background: #4e5ecf;
}

.taxiBody {
  position: absolute;
  left: 5px;
  bottom: 8px;
  width: 116px;
  height: 34px;
  border-radius: 16px 20px 10px 10px;
  background: linear-gradient(135deg,#5965f2,#777ff0);
  box-shadow: 0 13px 25px rgba(65,78,160,.20);
}

.taxiBody span {
  position: absolute;
  left: 35px;
  top: 6px;
  width: 44px;
  height: 12px;
  border-radius: 5px;
  background: rgba(220,230,250,.72);
}

.taxi i {
  position: absolute;
  bottom: 0;
  width: 17px;
  height: 17px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #202a41;
}

.taxi i:nth-of-type(1) {
  left: 18px;
}

.taxi i:nth-of-type(2) {
  right: 13px;
}

.illustrationCaption {
  position: absolute;
  left: 24px;
  bottom: 23px;
  display: grid;
  gap: 4px;
}

.illustrationCaption strong {
  color: #34405a;
  font-size: 10px;
  letter-spacing: .14em;
}

.illustrationCaption span {
  color: #7d879a;
  font-size: 10px;
}

.bottomHighlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 17px;
}

.bottomHighlights > div {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(255,255,255,.46);
  border: 1px solid rgba(255,255,255,.65);
}

.bottomHighlights b {
  flex: 0 0 23px;
  width: 23px;
  height: 23px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: #eef0ff;
  color: #5965f2;
  font-size: 11px;
}

.bottomHighlights span {
  display: grid;
  gap: 2px;
  color: #8a93a5;
  font-size: 9px;
  line-height: 1.35;
}

.bottomHighlights strong {
  color: #455169;
  font-size: 10px;
}

.rightColumn {
  min-width: 0;
  width: 100%;
}

.bookingPanel {
  width: 100%;
  overflow: hidden;
  border: 1px solid rgba(219,225,237,.95);
  border-radius: 26px;
  background: rgba(255,255,255,.97);
  box-shadow:
    0 30px 80px rgba(31,43,75,.15),
    0 4px 15px rgba(31,43,75,.05);
}

.bookingHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 25px 29px 21px;
  border-bottom: 1px solid #edf0f5;
}

.bookingHeader > div:first-child {
  min-width: 0;
}

.bookingHeader span {
  display: block;
  margin-bottom: 6px;
  color: #5965f2;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .16em;
}

.bookingHeader h2 {
  margin: 0;
  color: #172033;
  font-size: 31px;
  line-height: 1.05;
  letter-spacing: -.045em;
  font-weight: 900;
}

.bookingHeader p {
  margin: 7px 0 0;
  color: #7a8497;
  font-size: 12px;
}

.online {
  display: inline-flex !important;
  align-items: center;
  gap: 7px;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 8px 11px;
  border: 1px solid #e3e7f0;
  border-radius: 999px;
  background: #fafbfc;
  color: #687287 !important;
  font-size: 9px !important;
  letter-spacing: .1em;
}

.online i {
  width: 7px;
  height: 7px;
  margin: 0;
  border-radius: 50%;
  background: #35b779;
}

.widgetArea {
  width: 100%;
}

.bookingFooter {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 25px;
  padding: 14px 20px;
  border-top: 1px solid #edf0f5;
  background: #fafbfc;
  color: #7d879a;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 1150px) {
  .heroInner {
    min-height: auto;
    grid-template-columns: 1fr;
    padding: 40px 0;
  }

  .leftColumn {
    max-width: none;
  }

  .rightColumn {
    width: 100%;
  }
}

@media (max-width: 700px) {
  .heroInner {
    width: calc(100% - 22px);
    padding: 25px 0;
  }

  .intro h1 {
    font-size: 44px;
  }

  .intro p {
    font-size: 14px;
  }

  .mainIllustration {
    height: 215px;
    border-radius: 22px;
  }

  .bottomHighlights {
    grid-template-columns: 1fr;
  }

  .bookingHeader {
    align-items: flex-start;
    flex-direction: column;
    padding: 21px;
  }

  .bookingHeader h2 {
    font-size: 27px;
  }

  .bookingFooter {
    gap: 12px;
  }
}
